# VivahSambandh — Apache performance + security configuration.
# NOTE: applies only on Apache / cPanel-style static hosting. Local
# `vite preview` and non-Apache hosts (Vercel, Netlify, Nginx) ignore it.
# The Vite build already emits precompressed .gz/.br twins next to every
# JS/CSS/HTML/SVG/JSON asset; the rules below serve them with correct
# Content-Encoding instead of re-compressing on the fly.

# ——— No directory listings ———
Options -Indexes

# ——— Serve precompressed Brotli / Gzip twins ———
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Never serve sitemap.xml with a trailing slash (Prevents Google Search Console "Couldn't fetch" error)
  RewriteRule ^sitemap\.xml/$ /sitemap.xml [R=301,L,NC]

  # Prefer Brotli when the client accepts it and a .br twin exists.
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+)$ $1.br [L]

  # Fall back to Gzip.
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)$ $1.gz [L]

  # SPA Route Rewriting (redirect non-static URLs to index.html)
  RewriteBase /
  RewriteRule ^index\.html$ - [L]

  # CKEditor probes optional plugin files under /ckeditor/ and treats any 2xx
  # as "plugin loaded". Letting the SPA fallback answer those probes with
  # index.html would register nothing and leave the editor toolbar empty, so
  # the editor tree gets real 404s instead.
  RewriteRule ^ckeditor/ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Content-Encoding for the precompressed twins (keeps original MIME type).
<IfModule mod_headers.c>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary "Accept-Encoding"
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary "Accept-Encoding"
  </FilesMatch>
</IfModule>

# Serve precompressed twins with their original MIME types (prevents Apache from
# assigning Content-Type: application/x-gzip to .gz files).
<FilesMatch "\.html(\.gz|\.br)?$">
  ForceType text/html
</FilesMatch>
<FilesMatch "\.js(\.gz|\.br)?$">
  ForceType application/javascript
</FilesMatch>
<FilesMatch "\.css(\.gz|\.br)?$">
  ForceType text/css
</FilesMatch>
<FilesMatch "\.svg(\.gz|\.br)?$">
  ForceType image/svg+xml
</FilesMatch>
<FilesMatch "\.json(\.gz|\.br)?$">
  ForceType application/json
</FilesMatch>
<FilesMatch "\.xml(\.gz|\.br)?$">
  ForceType application/xml
</FilesMatch>

# Correct MIME types and encodings
<IfModule mod_mime.c>
  RemoveType .gz
  RemoveType .br
  AddEncoding br .br
  AddEncoding gzip .gz
  AddType application/javascript .js .mjs
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType application/json .json .ld+json
  AddType text/html .html
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType text/plain .txt
  AddType application/xml .xml
</IfModule>

# ——— On-the-fly compression fallback (assets without precompressed twins) ———
<IfModule mod_deflate.c>
  SetEnvIfNoCase Request_URI "\.(gz|br)$" no-gzip dont-vary
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
  BrowserMatch ^Mozilla/4 gzip-only-text/html
  BrowserMatch ^Mozilla/4\.0[678] no-gzip
</IfModule>

# ——— Caching ———
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed build assets (JS/CSS/fonts/images in /assets): immutable, 1 year.
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 1 day"

  # Entry HTML must revalidate so deploys go live immediately.
  ExpiresByType text/html "access plus 0 seconds"

  # Plain-text discovery files: short cache, crawling stays fresh.
  ExpiresByType text/plain "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # Immutable hashed assets: everything under /assets/ carries a content
  # hash in its filename (Apache 2.4 expression — FilesMatch only sees the
  # basename, never the path).
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Entry HTML: always revalidate (SPA shell + prerendered routes).
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Security headers (Best Practices hardening).
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>

# Accurate entity tags for conditional requests.
FileETag MTime Size
